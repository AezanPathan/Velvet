@page "/cubedemo"
@using Microsoft.JSInterop
@using Velvet.WebGL
@inject IJSRuntime JS

<PageTitle>Velvet WebGL Cube Demo</PageTitle>

<div class="cube-demo-container">
    <h1>Velvet Graphics Engine - Rotating Cube Demo</h1>
    <p class="description">3D rotating cube rendered with WebGL2 using the new VelvetAPI</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info">
            @statusMessage
        </div>
    }

    <div class="canvas-container">
        <canvas @ref="canvasRef" 
                width="800" 
                height="600"
                style="border: 2px solid #444; background: #000;">
        </canvas>
    </div>

    <div class="controls">
        <button class="btn btn-primary" @onclick="InitializeDemo" disabled="@isInitialized">
            Initialize Demo
        </button>
        <button class="btn btn-success" @onclick="StartAnimation" disabled="@(!isInitialized || isAnimating)">
            Start Animation
        </button>
        <button class="btn btn-warning" @onclick="StopAnimation" disabled="@(!isAnimating)">
            Stop Animation
        </button>
    </div>

    <div class="info-panel">
        <h3>Velvet API Status</h3>
        <ul>
            <li><strong>Renderer ID:</strong> @rendererId</li>
            <li><strong>Vertex Shader ID:</strong> @vertexShaderId</li>
            <li><strong>Fragment Shader ID:</strong> @fragmentShaderId</li>
            <li><strong>Program ID:</strong> @programId</li>
            <li><strong>Mesh ID:</strong> @meshId</li>
            <li><strong>Status:</strong> @(isAnimating ? "Animating" : isInitialized ? "Ready" : "Not Initialized")</li>
        </ul>
    </div>
</div>

<style>
    .cube-demo-container {
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
        font-family: system-ui, -apple-system, sans-serif;
    }

    h1 {
        color: #333;
        margin-bottom: 0.5rem;
    }

    .description {
        color: #666;
        margin-bottom: 2rem;
    }

    .canvas-container {
        margin: 2rem 0;
        text-align: center;
        background: #111;
        padding: 1rem;
        border-radius: 8px;
    }

    canvas {
        border: 2px solid #444;
        max-width: 100%;
        height: auto;
        display: inline-block;
    }

    .controls {
        display: flex;
        gap: 1rem;
        margin: 2rem 0;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-primary {
        background: #007bff;
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background: #0056b3;
    }

    .btn-success {
        background: #28a745;
        color: white;
    }

    .btn-success:hover:not(:disabled) {
        background: #218838;
    }

    .btn-warning {
        background: #ffc107;
        color: #212529;
    }

    .btn-warning:hover:not(:disabled) {
        background: #e0a800;
    }

    .alert {
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 1rem;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .alert-info {
        background: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .info-panel {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
        margin-top: 2rem;
    }

    .info-panel h3 {
        margin-top: 0;
        color: #495057;
    }

    .info-panel ul {
        list-style: none;
        padding: 0;
    }

    .info-panel li {
        padding: 0.5rem 0;
        border-bottom: 1px solid #dee2e6;
    }

    .info-panel li:last-child {
        border-bottom: none;
    }
</style>
